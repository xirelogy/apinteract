{
  "name": "@apinteract/backend",
  "version": "0.1.0-alpha7",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "apinteract": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts --config ../../var/config/backend.yaml",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apinteract/api-contracts": "workspace:*",
    "@apinteract/plugin-api": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.2.0",
    "better-sqlite3": "12.4.1",
    "fastify": "5.12.1",
    "jose": "6.1.0",
    "kysely": "0.28.17",
    "quickjs-emscripten": "0.31.0",
    "uuid": "13.0.2",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
