{
  "name": "@apinteract/plugin-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./frontend": {
      "types": "./src/frontend.ts",
      "default": "./dist/frontend.js"
    },
    "./backend": {
      "types": "./src/backend.ts",
      "default": "./dist/backend.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apinteract/api-contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
