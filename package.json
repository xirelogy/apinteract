{
  "name": "apinteract",
  "version": "0.1.0-alpha3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm contracts:generate && pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm contracts:check && pnpm source-docs:check && pnpm lint && pnpm typecheck && pnpm test",
    "contracts:check": "node tooling/check-generated-contracts.mjs",
    "contracts:generate": "pnpm --filter @apinteract/api-contracts generate",
    "dev": "pnpm dev:prepare && node tooling/run-development.mjs",
    "dev:backend": "pnpm --filter @apinteract/backend dev",
    "dev:frontend": "pnpm --filter @apinteract/frontend dev",
    "dev:init-admin": "pnpm dev:prepare && pnpm --filter @apinteract/backend exec tsx src/cli.ts admin init --config ../../var/config/backend.yaml",
    "dev:prepare": "pnpm --filter @apinteract/plugin-api build && pnpm plugins:build && node tooling/prepare-development.mjs",
    "dev:proxy": "pnpm --filter @apinteract/proxy dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && stylelint \"apps/frontend/src/**/*.css\"",
    "plugins:build": "pnpm --filter './plugins/**' build",
    "source-docs:check": "node tooling/check-source-documentation.mjs",
    "test": "pnpm --filter @apinteract/plugin-api build && pnpm -r --if-present test && node --test deploy/aio/runtime/*.test.mjs tooling/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "pnpm contracts:generate && pnpm -r --if-present typecheck"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9",
      "fast-uri@^3.0.0": "3.1.5",
      "fast-uri@^4.0.0": "4.1.3",
      "find-my-way@^9.6.0": "9.9.0",
      "js-yaml@^4.0.0": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.26"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.57.0",
    "@redocly/cli": "2.39.0",
    "@types/node": "24.10.0",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.38.0",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.2.0"
  }
}
